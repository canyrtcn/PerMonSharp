#include <winresrc.h>
#include "resource.h"

IDI_APP_ICON ICON "PerMonSharp.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "PerMonSharp.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PerMonSharp Contributors"
            VALUE "FileDescription", "Lightweight Per-Monitor Sharpness Control for Windows"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "PerMonSharp"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "PerMonSharp.exe"
            VALUE "ProductName", "PerMonSharp"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
